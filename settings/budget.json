{
  "model": "sonnet",
  "effortLevel": "medium",
  "promptCacheTtl": "1h",
  "autoCompactWindow": 200000,
  "awaySummaryEnabled": false,
  "promptSuggestionEnabled": false,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "KIT_BUDGET_USD": "250"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
